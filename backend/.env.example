# Copy this file to .env for local development.
# In production, set these as real environment variables instead.

NODE_ENV=development
PORT=3000

# These match compose.yml
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db

# Must be long and random string in production. Generate a new one for production with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=local-development-secret-do-not-use-in-production

# The API's public URL, e.g. https://api.example.com in production
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=50

# local or s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Only needed when STORAGE_DRIVER=s3
S3_BUCKET=
AWS_REGION=
